# ─────────────────────────────────────────────────────────────
# AegisHeal configuration (environment variables)
# Easiest: run `npm run setup` — it creates server/.env with a random JWT_SECRET.
# Or copy this file to `.env` (repo root) or `server/.env` and fill in your values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# If both exist, server/.env wins. Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

# HTTP port of the API server (the dashboard proxies /api to it)
API_PORT=4000

# development | production | test
NODE_ENV=development

# Where the React app runs (used for CORS in development)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. MUST be 32+ random characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Login session lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Folder for the JSON database (users, incidents, audit, settings)
DATA_DIR=./data

# First port used by the managed demo services (uses 3 consecutive ports)
SERVICE_BASE_PORT=5101

# How often the monitor probes every service (milliseconds, min 500)
MONITOR_INTERVAL_MS=2000

# Initial agent mode: autonomous | supervised | observe
AGENT_MODE=autonomous

# Default admin created by `npm run seed` (change the password after first login!)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@aegisheal.local
ADMIN_PASSWORD=Admin@12345

# ── Optional: Claude AI analyser ─────────────────────────────
# local  = built-in reasoning engine (works offline, default)
# claude = use Anthropic Claude for root-cause analysis (needs API key)
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# error | warn | info | debug
LOG_LEVEL=info

# auto (secure cookies only in production) | true | false
# Use false only for a production build served over plain HTTP on a local network.
COOKIE_SECURE=auto
